<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="v1.0.0" android:textStyle="bold" android:textSize="22sp" android:layout_marginBottom="4dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Developed by Rohit Singh" android:textSize="16sp" android:textColor="?android:attr/textColorSecondary" android:layout_marginBottom="16dp"/>

    <ImageView android:layout_width="match_parent" android:layout_height="200dp" android:src="@drawable/sample_slip" android:scaleType="centerInside" android:layout_marginBottom="16dp" android:background="#E0E0E0"/>

    <!-- NEW: Export to CSV Button -->
    <Button android:id="@+id/btn_export_csv" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Export Data to CSV" android:backgroundTint="#4CAF50" android:drawableStart="@android:drawable/ic_menu_save" android:paddingStart="16dp" android:layout_marginBottom="24dp"/>

    <!-- GitHub Link -->
    <TextView android:id="@+id/tv_github" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="github.com/RohitSingh-04" android:textSize="16sp" android:padding="12dp" android:drawableStart="@android:drawable/ic_menu_myplaces" android:drawablePadding="16dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:autoLink="web"/>

    <!-- LinkedIn Link -->
    <TextView android:id="@+id/tv_linkedin" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="linkedin.com/in/rohiyaa" android:textSize="16sp" android:padding="12dp" android:drawableStart="@android:drawable/ic_menu_share" android:drawablePadding="16dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:autoLink="web"/>

    <!-- Email Link -->
    <TextView
        android:id="@+id/tv_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:drawableStart="@drawable/ic_notifications_black_24dp"
        android:drawablePadding="16dp"
        android:padding="12dp"
        android:text="rsingh.py@gmail.com"
        android:textSize="16sp" />


    <Button android:id="@+id/btn_close_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Close" android:layout_marginTop="24dp" android:backgroundTint="#757575"/>
</LinearLayout>