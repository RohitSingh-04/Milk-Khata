<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Data Analysis" android:textSize="24sp" android:textStyle="bold" android:layout_marginBottom="16dp"/>

        <!-- Rate Per Day -->
        <androidx.cardview.widget.CardView android:id="@+id/card_rate" android:layout_width="match_parent" android:layout_height="80dp" android:layout_marginBottom="12dp" app:cardCornerRadius="8dp" app:cardElevation="4dp" android:clickable="true" android:foreground="?android:attr/selectableItemBackground">
            <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="Rate Per Day (Bar Chart)" android:gravity="center_vertical" android:padding="16dp" android:textSize="18sp" android:drawableStart="@drawable/baseline_ssid_chart_24" android:drawablePadding="16dp"/>
        </androidx.cardview.widget.CardView>

        <!-- Amount Per Day -->
        <androidx.cardview.widget.CardView android:id="@+id/card_amount" android:layout_width="match_parent" android:layout_height="80dp" android:layout_marginBottom="12dp" app:cardCornerRadius="8dp" app:cardElevation="4dp" android:clickable="true" android:foreground="?android:attr/selectableItemBackground">
            <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="Amount Per Day (Line Chart)" android:gravity="center_vertical" android:padding="16dp" android:textSize="18sp" android:drawableStart="@drawable/baseline_ssid_chart_24" android:drawablePadding="16dp"/>
        </androidx.cardview.widget.CardView>

        <!-- Quantity Per Day -->
        <androidx.cardview.widget.CardView android:id="@+id/card_qty" android:layout_width="match_parent" android:layout_height="80dp" android:layout_marginBottom="12dp" app:cardCornerRadius="8dp" app:cardElevation="4dp" android:clickable="true" android:foreground="?android:attr/selectableItemBackground">
            <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="Quantity Per Day (Bar Chart)" android:gravity="center_vertical" android:padding="16dp" android:textSize="18sp" android:drawableStart="@drawable/baseline_ssid_chart_24" android:drawablePadding="16dp"/>
        </androidx.cardview.widget.CardView>

        <!-- Frequency Per Day -->
        <androidx.cardview.widget.CardView android:id="@+id/card_freq" android:layout_width="match_parent" android:layout_height="80dp" android:layout_marginBottom="12dp" app:cardCornerRadius="8dp" app:cardElevation="4dp" android:clickable="true" android:foreground="?android:attr/selectableItemBackground">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:drawableStart="@drawable/ic_dashboard_black_24dp"
                android:drawablePadding="16dp"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:text="Entry Frequency Per Day (Bar Chart)"
                android:textSize="18sp" />
        </androidx.cardview.widget.CardView>

        <!-- Info -->
        <androidx.cardview.widget.CardView android:id="@+id/card_info" android:layout_width="match_parent" android:layout_height="80dp" android:layout_marginBottom="12dp" app:cardCornerRadius="8dp" app:cardElevation="4dp" android:clickable="true" android:foreground="?android:attr/selectableItemBackground">
            <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="Info &amp; Developer" android:gravity="center_vertical" android:padding="16dp" android:textSize="18sp" android:drawableStart="@android:drawable/ic_dialog_info" android:drawablePadding="16dp"/>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>